# OpenMU Browser Stack Configuration

# WebSocket Proxy (internal; the web server forwards /ws here)
WS_PORT=7100
WS_HOST=127.0.0.1

# Web Server (serves WASM client)
WEB_PORT=8085
WEB_HOST=0.0.0.0

# OpenMU Connect Server (initial connection)
MU_CONNECT_HOST=127.0.0.1
MU_CONNECT_PORT=44405

# OpenMU Game Server host (used for IP remapping in ConnectionInfo packets)
MU_GAME_HOST=127.0.0.1

# Public address written into ConnectionInfo packets (what the WASM client
# reconnects to). "auto" reuses the host/port the browser connected to, which
# is what LAN and HTTPS deployments need. Behind nginx it also honours
# X-Forwarded-Host / X-Forwarded-Port.
PROXY_PUBLIC_HOST=auto
PROXY_PUBLIC_PORT=auto

# Where the web server forwards /ws upgrades. Defaults to the local proxy.
# WS_FORWARD_HOST=127.0.0.1
# WS_FORWARD_PORT=7100

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-* (real client
# IP). Defaults to loopback. Docker's compose service adds its bridge range.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# TLS (HTTPS + WSS). Required to play from another device without a reverse
# proxy: WebGPU only exists in secure contexts, and browsers only treat
# localhost as secure.
#
# Generate a certificate with mkcert (see README) and then uncomment:
# TLS_CERT_PATH=certs/server.crt
# TLS_KEY_PATH=certs/server.key
#
# Behind nginx with a Let's Encrypt certificate, leave both empty: nginx
# terminates TLS and proxies to this stack over loopback.
#
# Docker: to serve HTTPS directly from the container, mount ./certs in
# docker-compose.yml and use these paths instead:
# DOCKER_TLS_CERT_PATH=/app/certs/server.crt
# DOCKER_TLS_KEY_PATH=/app/certs/server.key
